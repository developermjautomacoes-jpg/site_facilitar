# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Contact Emails
CONTACT_EMAIL=contato@facilitar.net.br
CONTACT_EMAIL_CC=monique@facilitar.net.br

# Site
NEXT_PUBLIC_SITE_URL=https://facilitar.net.br
NEXT_PUBLIC_WHATSAPP=5527999858502

# CSRF
CSRF_SECRET=troque-por-string-aleatoria-de-32-chars

# Sessão do portal (obrigatório em produção, mínimo 32 caracteres aleatórios)
SESSION_SECRET=troque-por-string-aleatoria-de-64-chars

# Pasta dos dados persistentes (no Docker/Easypanel já vem como /app/storage)
# DATA_DIR=/app/storage

# Senha do admin criado automaticamente quando não existe users.json (opcional)
# ADMIN_INITIAL_PASSWORD=
